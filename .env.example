# LeYu Frontend Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for the backend API server
# Development: http://localhost:3003/api
# Production: https://your-api-domain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Base URL for the frontend application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Authentication Configuration (NextAuth.js)
# =============================================================================

# Secret key for NextAuth.js session encryption
# IMPORTANT: Generate a strong random string (minimum 32 characters) for production
# You can generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=your-strong-secret-here-minimum-32-characters

# Canonical URL of your site for NextAuth.js
# This should match your NEXT_PUBLIC_BASE_URL
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# Optional Configuration
# =============================================================================

# Custom port for development server (default: 3000)
# PORT=3000

# Node environment (development, production, test)
# NODE_ENV=development

# =============================================================================
# Production Example
# =============================================================================
# For production deployment, your .env file should look like:
#
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# NEXTAUTH_SECRET=your-very-strong-production-secret-minimum-32-characters
# NEXTAUTH_URL=https://yourdomain.com

# =============================================================================
# Security Notes
# =============================================================================
# - Never commit .env files with real values to version control
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Keep NEXTAUTH_SECRET secure and never expose it
# - Use HTTPS URLs in production
# - Regularly rotate secrets and API keys